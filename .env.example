# Copy to .env.local and fill in. Server-only: never prefix these with NEXT_PUBLIC_.

# AI opponents. A model is only in the pool if its key is set, so set at least one.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# Encrypts the round token that hides which model you're playing. Generate with: openssl rand -base64 32
ROUND_TOKEN_SECRET=

# Optional model overrides (defaults live in lib/models.ts)
# CLAUDE_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-6-sol
# GEMINI_MODEL=gemini-3.8-flash
# GROK_MODEL=grok-4.20-0309-non-reasoning
# DEEPSEEK_MODEL=deepseek-flash
# OpenAI reasoning effort: none | minimal | low | medium | high, or "off" to omit the parameter
# OPENAI_REASONING_EFFORT=low

# Where the round log and the AI's notes are saved (default: ./data)
# TRUSTFALL_DATA_DIR=./data

# Testing: always play this model (claude | openai | gemini | grok | deepseek)
# FORCE_OPPONENT=grok

# Accounts are off in Stage 1. Leave unset (or false) to play as a local guest.
# NEXT_PUBLIC_AUTH_ENABLED=false
